{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Selfrace Game Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/game/game.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--checkpoint",
                "${workspaceFolder}/training/checkpoints-paper-goals/ckpt_step_400.pt",
                "--device",
                "cpu",
                "--envs",
                "1",
                "--agents",
                "24"
            ]
        }
    ]
}
